# Enable OpenSSH; set to false to disable it
ENABLE_OPENSSH=true

# Required when OpenSSH is enabled
SSH_PASSWORD=

# Host port mapped to container port 22
SSH_PORT=2222

# Enable Tailscale SSH; set to true to use it
ENABLE_TAILSCALED=false

# Required for initial Tailscale enrollment when Tailscale is enabled
# Create one in the Tailscale admin console
TS_AUTHKEY=

# Hostname used to identify this container in your tailnet
TS_HOSTNAME=devcontainer-ssh

# Optional host directory mount for VS Code Dev Containers extension
WORKSPACE_PATH=